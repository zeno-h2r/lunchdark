  },
  "self": {
   "href": "/api/v2/integration-manifests/msteams-app",
   "type": "application/json"
  },
  "subscriptions": {
   "href": "/api/v2/integrations/msteams-app",
   "type": "application/json"
  }
 },
 "key": "msteams-app",
 "additionalFields": {
  "status": "default",
  "upsellKind": "none",
  "shouldUpsell": false
 },
 "oauth": {
  "connected": false,
  "member": ""
 },
 "author": "LaunchDarkly",
 "capabilities": {
  "auditLogEventsHook": {
   "defaultPolicy": [
    {
     "actions": [
      "*"
     ],
     "effect": "allow",
     "resources": [
      "proj/*:env/production:flag/*"
     ]
    }
   ],
   "deliveryMethod": "",
   "endpoint": {
    "headers": [
     {
      "name": "Content-Type",
      "value": "application/json"
     }
    ],
    "hmacSignature": {
     "headerName": "X-LD-Signature",
     "hmacSecretFormVariableKey": "secret"
    },
    "method": "POST",
    "url": "{{url}}"
   },
   "includeErrorResponseBody": false,
   "templates": {},
   "useStandardWebhookPayload": true
  },
  "flagLink": {
   "emptyState": {
    "title": "No Microsoft Teams conversations link to this flag."
   },
   "header": "Microsoft Teams conversation",
   "metadata": {
    "avatarUrl": {
     "type": "uri"
    },
    "channelName": {
     "type": "string"
    },
    "displayName": {
     "type": "string"
    },
    "message": {
     "type": "string"
    }
   },
   "uiBlocks": {
    "context": {
     "elements": [
      {
       "isBold": false,
       "isTimestamp": false,
       "text": "Posted in",
       "url": ""
      },
      {
       "isBold": true,
       "isTimestamp": false,
       "text": "#{{{metadata.channelName}}}",
       "url": ""
      },
      {
       "isBold": false,
       "isTimestamp": false,
       "text": "View message",
       "url": "{{{deepLink}}}"
      }
     ]
    },
    "description": "{{{metadata.message}}}",
    "image": {
     "isAvatar": true,
     "isIcon": false,
     "sourceUrl": "{{{metadata.avatarUrl}}}"
    },
    "name": "{{{metadata.displayName}}}"
   }
  },
  "hideConfiguration": true
 },
 "categories": [
  "messaging"
 ],
 "description": "With the LaunchDarkly Microsoft Teams app, you can view, monitor, and control feature flags directly from your Teams workspaces. Use the app to find feature flags, subscribe channels to notifications about flag changes, and toggle flags on or off.",
