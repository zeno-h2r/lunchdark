 "capabilities": {
  "auditLogEventsHook": {
   "defaultPolicy": [
    {
     "actions": [
      "updateFallthrough",
      "updateFlagVariations",
      "updateFeatureWorkflows",
      "updateGlobalArchived",
      "updateOffVariation",
      "updateOn",
      "updatePrerequisites",
      "updateRules",
      "updateScheduledChanges",
      "updateTargets",
      "createFlag",
      "deleteFlag",
      "updateClientSideFlagAvailability",
      "updateFlagDefaultVariations",
      "updateName",
      "updateTemporary",
      "createTriggers",
      "deleteTriggers",
      "updateTriggers",
      "updateFlagSalt"
     ],
     "effect": "allow",
     "resources": [
      "proj/*:env/production:flag/*"
     ]
    }
   ],
   "deliveryMethod": "",
   "endpoint": {
    "headers": [
     {
      "name": "Content-Type",
      "value": "application/json"
     }
    ],
    "hmacSignature": {
     "headerName": "X-LD-Signature",
     "hmacSecretFormVariableKey": "secretToken"
    },
    "method": "POST",
    "url": "{{receiverURL}}"
   },
   "includeErrorResponseBody": false,
   "templates": {},
   "useStandardWebhookPayload": true
  }
 },
 "categories": [
