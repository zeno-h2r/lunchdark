  "auditLogEventsHook": {
   "defaultPolicy": [
    {
     "actions": [
      "*"
     ],
     "effect": "allow",
     "resources": [
      "proj/*:env/*:flag/*"
     ]
    }
   ],
   "deliveryMethod": "",
   "endpoint": {
    "headers": [
     {
      "name": "Content-Type",
      "value": "application/json"
     }
    ],
    "hmacSignature": {
     "headerName": "X-LD-Signature",
     "hmacSecretFormVariableKey": "secret"
    },
    "method": "POST",
    "url": "{{url}}"
   },
   "includeErrorResponseBody": false,
   "templates": {},
   "useStandardWebhookPayload": true
  },
  "flagLink": {
   "emptyState": {
    "leadText": "To enable the Jira integration, [read the documentation](https://launchdarkly.com/docs/home/flags/links#create-jira-flag-links)",
    "title": "No Jira issues link to this flag."
   },
   "header": "Jira issue",
   "metadata": {
    "creator": {
     "type": "string"
    },
    "iconUrl": {
     "type": "uri"
    },
    "issueKey": {
     "type": "string"
    },
    "issueTitle": {
     "type": "string"
    }
   },
   "uiBlocks": {
    "context": {
     "elements": [
      {
       "isBold": false,
       "isTimestamp": false,
       "text": "Issue created by",
       "url": ""
      },
      {
       "isBold": true,
       "isTimestamp": false,
       "text": "{{{metadata.creator}}}",
       "url": ""
      }
     ]
    },
    "image": {
     "isAvatar": false,
     "isIcon": true,
     "sourceUrl": "{{{metadata.iconUrl}}}"
    },
    "title": {
     "elements": [
      {
       "isBold": false,
       "isTimestamp": false,
       "text": "{{{metadata.issueKey}}}: {{{metadata.issueTitle}}}",
       "url": ""
      }
     ],
     "linkToReference": true
    }
   }
  },
  "hideConfiguration": true,
  "jiraIssueCreate": {
   "creationRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ],
     "hmacSignature": {
      "headerName": "X-LD-Signature",
      "hmacSecretFormVariableKey": "secret"
     },
     "method": "POST",
     "url": "{{issueCreateUrl}}"
    },
    "jsonBody": "{\"title\":\"{{{title}}}\",\"description\":\"{{{description}}}\",\"projectKey\":\"{{{projectKey}}}\",\"issueType\":\"{{{issueType}}}\",\"labels\":{{{labelsJson}}},\"sourceLink\":\"{{{sourceLink}}}\",\"sourceKind\":\"{{{sourceKind}}}\"}",
    "parser": {
     "issueKey": "/issueKey",
     "issueUrl": "/issueUrl",
     "self": "/self"
    }
   },
   "issueCreateFormVariables": null,
   "name": "Jira issue"
  }
 },
 "categories": [
  "issue-tracking"
 ],
 "description": "Integrate LaunchDarkly with Jira to see your feature flags alongside your team's Jira issues.",
 "details": "Jira is the #1 software development tool used by agile teams to plan, track, and release great software. Built for all team members, Jira enables collaboration by providing everyone with visibility into important information for planning and coordinating projects, tracking progress, and reporting results in real-time. Integrate LaunchDarkly with Jira to see your feature flags alongside your team's Jira issues.",
