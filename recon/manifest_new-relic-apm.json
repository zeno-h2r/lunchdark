  "shouldUpsell": false
 },
 "oauth": {
  "connected": false,
  "member": ""
 },
 "author": "LaunchDarkly",
 "capabilities": {
  "auditLogEventsHook": {
   "defaultPolicy": [
    {
     "actions": [
      "*"
     ],
     "effect": "allow",
     "resources": [
      "proj/*:env/production:flag/*"
     ]
    }
   ],
   "deliveryMethod": "",
   "endpoint": {
    "headers": [
     {
      "name": "X-Api-Key",
      "value": "{{apiKey}}"
     },
     {
      "name": "Content-Type",
      "value": "application/json"
     }
    ],
    "hmacSignature": null,
    "method": "POST",
    "url": "https://{{#if domain}}{{domain}}{{else}}api.newrelic.com{{/if}}/v2/applications/{{applicationId}}/deployments.json"
   },
   "includeErrorResponseBody": false,
   "templates": {
    "flag": "templates/flag.json.hbs",
    "validation": "templates/flag.json.hbs"
   },
   "useStandardWebhookPayload": false
  },
  "trigger": {
   "auth": "",
   "defaultEventName": "",
   "documentation": "https://launchdarkly.com/docs/integrations/new-relic/triggers#connect-a-flag-trigger-to-new-relic-one",
   "parser": {
    "eventName": "/condition_name",
    "url": "/incident_url"
   },
   "testEventNameRegexp": "^New Relic Alert - Test Condition$"
  }
 },
 "categories": [
  "monitoring"
 ],
 "description": "This integration sends LaunchDarkly audit events to New Relic as [deployment events](https://docs.newrelic.com/docs/apm/new-relic-apm/maintenance/record-monitor-deployments). Deprecated: New Relic no longer accepts REST API keys. Use the New Relic change tracking integration instead.",
