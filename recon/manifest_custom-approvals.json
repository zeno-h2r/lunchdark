 },
 "key": "custom-approvals",
 "additionalFields": {
  "status": "default",
  "upsellKind": "none",
  "shouldUpsell": false
 },
 "oauth": {
  "connected": false,
  "member": ""
 },
 "allowIntegrationConfigurations": true,
 "author": "LaunchDarkly",
 "capabilities": {
  "approval": {
   "allowAdditionalApprovalFormVariables": true,
   "allowApprovalIntegrationConfigurations": true,
   "approvalFormVariables": [],
   "creationRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Content-Type",
       "value": "application/json"
      },
      {
       "name": "Authorization",
       "value": "Bearer {{ apiKey }}"
      }
     ],
     "hmacSignature": null,
     "method": "POST",
     "url": "{{ baseURL }}/api/approvals"
    },
    "jsonBody": "{\"_site\": {\"href\": \"{{_links.approval.href}}\"}, \"_id\": \"{{approvalId}}\", {{#if details.plainText}}\"details\": \"{{{details.plainText}}}\",{{/if}} \"project\": {\"name\":\"{{{project.name}}}\", \"key\": \"{{project.key}}\", \"tags\":[{{#each project.tags}}\"{{{this}}}\"{{#if @last}}{{else}},{{/if}}{{/each}}]}, \"environment\": {\"name\":\"{{{project.environment.name}}}\", \"key\": \"{{project.environment.key}}\", \"tags\":[{{#each project.environment.tags}}\"{{this}}\"{{#if @last}}{{else}},{{/if}}{{/each}}]}, \"{{{resource.resourceKind}}}\": {\"name\":\"{{{resource.name}}}\", \"key\": \"{{resource.key}}\", \"tags\":[{{#each resource.tags}}\"{{this}}\"{{#if @last}}{{else}},{{/if}}{{/each}}]},{{#if title.member}}\"requestedBy\": {\"id\": \"{{member._id}}\", \"email\": \"{{member.email}}\"},{{/if}}\"shortDescription\": \"{{{title.plainText}}}\", \"timestamp\": \"{{timestamp.milliseconds}}\", \"approvalFormVariables\": { {{#each approvalFormVariables}} \"{{@key}}\": \"{{{this}}}\"{{#if @last}}{{else}},{{/if}}{{/each}} },\"comment\": \"{{{approvalDescription}}}\" }",
    "parser": {
     "approvalId": "/_id",
     "approvalMatcher": "approved",
     "rejectionMatcher": "declined",
     "statusDisplay": "/status/display",
     "statusValue": "/status/value",
     "urlTemplate": "{{ baseURL }}/approvals?approvalID={{ context.approvalId }}"
    }
   },
   "deletionRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Content-Type",
       "value": "application/json"
      },
      {
       "name": "Authorization",
       "value": "Bearer {{ apiKey }}"
      }
     ],
     "hmacSignature": null,
     "method": "POST",
     "url": "{{ baseURL }}/api/approvals/{{ context.approvalId }}/cancel"
    },
    "jsonBody": "",
    "parser": {
     "approvalId": "",
     "approvalMatcher": "approved",
     "rejectionMatcher": "declined",
     "statusDisplay": "/status/display",
     "statusValue": "/status/value",
     "urlTemplate": ""
    }
   },
   "environmentFormVariables": null,
   "memberListRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Authorization",
       "value": "Bearer {{apiKey}}"
      }
     ],
     "hmacSignature": null,
     "method": "GET",
     "url": "{{baseURL}}/api/members"
    },
    "jsonBody": "",
    "parser": {
     "memberArrayPath": "/members",
     "memberItems": {
      "email": "/email",
      "memberId": "/name"
     }
    }
   },
   "name": "Custom Approvals",
   "postApplyRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Content-Type",
       "value": "application/json"
      },
      {
       "name": "Authorization",
       "value": "Bearer {{ apiKey }}"
      }
     ],
     "hmacSignature": null,
     "method": "POST",
     "url": "{{ baseURL }}/api/approvals/{{ context.approvalId }}/apply"
    },
    "jsonBody": "",
    "parser": {
     "approvalId": "",
     "approvalMatcher": "approved",
     "rejectionMatcher": "declined",
     "statusDisplay": "/status/display",
     "statusValue": "/status/value",
     "urlTemplate": ""
    }
   },
   "statusRequest": {
    "endpoint": {
     "headers": [
      {
       "name": "Authorization",
       "value": "Bearer {{ apiKey }}"
      }
     ],
     "hmacSignature": null,
     "method": "GET",
     "url": "{{ baseURL }}/api/approvals/{{ context.approvalId }}/status"
    },
    "jsonBody": "",
    "parser": {
     "approvalId": "",
     "approvalMatcher": "approved",
     "rejectionMatcher": "declined",
     "statusDisplay": "/status/display",
     "statusValue": "/status/value",
     "urlTemplate": ""
    }
   }
  }
 },
